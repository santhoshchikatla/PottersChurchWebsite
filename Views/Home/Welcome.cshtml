@{
    ViewData["Title"] = "Welcome";
    Layout = "~/Views/Shared/_HeaderLayout.cshtml";
}


<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700;900&family=DM+Sans:wght@300;400;500;600&family=Bebas+Neue&display=swap" rel="stylesheet" />
<link href="~/css/welcome.css" rel="stylesheet" />


<!-- ═══════════════ HERO ═══════════════ -->
<section class="hero">
    <div class="hero-dots"></div>
    <div class="hero-cross"></div>

    <div class="hero-content">
        <div class="logo-pill">
            <i class="fa-solid fa-church" style="color:var(--gold-light);font-size:1.1rem;"></i>
            <span>The Potter's Church · Hyderabad</span>
        </div>

        <div class="welcome-tag">We're so glad you're here</div>

        <h1 class="hero-title">WELCOME<br><span>HOME</span></h1>

        <p class="hero-sub">
            The most important thing about Potter's Church is not what makes us distinct —
            it's what we share in common with every other true church.
        </p>

        <div class="hero-cta">
            <a href="#welcome-form" class="btn-gold">
                <i class="fa-solid fa-pen-to-square me-2"></i>Share Your Info
            </a>
            <a href="#connect" class="btn-outline-white">
                Connect With Us
            </a>
        </div>

        <div class="hero-service">
            <div class="service-pill">
                <i class="fa-regular fa-clock"></i>
                <div>
                    <strong>8:00AM &amp; 10:30AM</strong>
                    <small>Sunday Gatherings</small>
                </div>
            </div>
            <div class="service-pill">
                <i class="fa-solid fa-location-dot"></i>
                <div>
                    <strong>KPHB 5th Phase</strong>
                    <small>Kukatpally, Hyderabad</small>
                </div>
            </div>
            <div class="service-pill">
                <i class="fa-brands fa-youtube"></i>
                <div>
                    <strong>Live on YouTube</strong>
                    <small>Weekly Sermons</small>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ═══════════════ WELCOME FORM ═══════════════ -->


<div class="tab-section">
    <p class="section-eyebrow">Get Involved</p>
    <h2 class="section-title">Choose Your <span>Next Step</span></h2>

    <div class="tabs-row" role="tablist">
        <button class="tab-btn active" onclick="showTab('welcome')" role="tab">
            <div class="tab-icon"><i class="fa-solid fa-handshake" style="color:#a71e30;"></i></div>
            <span class="tab-label">Welcome Card</span>
            <span class="tab-sub">First time here?</span>
        </button>
        <button class="tab-btn" onclick="showTab('prayer')" role="tab">
            <div class="tab-icon"><i class="fa-solid fa-hands-praying" style="color:#a71e30;"></i></div>
            <span class="tab-label">Prayer Request</span>
            <span class="tab-sub">We pray with you</span>
        </button>
        <button class="tab-btn" onclick="showTab('membership')" role="tab">
            <div class="tab-icon"><i class="fa-solid fa-people-group" style="color:#a71e30;"></i></div>
            <span class="tab-label">Membership</span>
            <span class="tab-sub">Take the step</span>
        </button>
        <button class="tab-btn" onclick="showTab('nextsteps')" role="tab">
            <div class="tab-icon"><i class="fa-solid fa-book-open" style="color:#a71e30;"></i></div>
            <span class="tab-label">Next Steps</span>
            <span class="tab-sub">Serve with us</span>
        </button>
    </div>

    <!-- FORM 1: WELCOME CARD -->
    <div class="form-card active" id="tab-welcome">
        <div class="card-header">
            <div class="card-header-icon"><i class="fa-solid fa-handshake" style="color:#ffe0e3;"></i></div>
            <div>
                <h3>Welcome!</h3>
                <p>We'd love to get to know you — fill in your details below</p>
            </div>
        </div>
        <div class="card-body">
            <div class="form-row">
                <div class="form-group">
                    <label class="fl">Full Name *</label>
                    <input type="text" placeholder="Your full name" />
                </div>
                <div class="form-group">
                    <label class="fl">Date of Visit</label>
                    <input type="date" id="welcome-date" />
                </div>
            </div>
            <div class="form-group">
                <label class="fl">Address</label>
                <input type="text" placeholder="Your home address" />
            </div>
            <div class="form-row">
                <div class="form-group">
                    <label class="fl">Phone Number</label>
                    <input type="tel" placeholder="+91 00000 00000" />
                </div>
                <div class="form-group">
                    <label class="fl">Social Media ID</label>
                    <input type="text" placeholder="you@email.com" />
                </div>
            </div>
            <div class="form-group">
                <label class="fl">Anything you'd like us to know</label>
                <textarea rows="2" placeholder="Share anything on your heart..."></textarea>
            </div>
            <hr class="divider" />
            <div class="form-group">
                <label class="fl" style="margin-bottom:10px;">I am here because</label>
                <div class="check-grid-2">
                    <label class="check-item"><input type="checkbox" /><span>New to this Area</span></label>
                    <label class="check-item"><input type="checkbox" /><span>Looking for a New Church</span></label>
                    <label class="check-item"><input type="checkbox" /><span>On Vacation</span></label>
                    <label class="check-item"><input type="checkbox" /><span>Interested in Learning More</span></label>
                </div>
            </div>
            <button class="submit-btn"><i class="fa-solid fa-paper-plane"></i> Submit Welcome Card</button>
        </div>
    </div>

    <!-- FORM 2: PRAYER REQUEST -->
    <div class="form-card" id="tab-prayer">
        <div class="card-header">
            <div class="card-header-icon"><i class="fa-solid fa-hands-praying" style="color:#ffe0e3;"></i></div>
            <div>
                <h3>Prayer Request</h3>
                <p>Share your need — our team prays over every request, personally</p>
            </div>
        </div>
        <div class="card-body">
            <div class="form-row">
                <div class="form-group">
                    <label class="fl">Your Name *</label>
                    <input type="text" placeholder="Full name" />
                </div>
                <div class="form-group">
                    <label class="fl">Phone / Email</label>
                    <input type="text" placeholder="How can we reach you?" />
                </div>
            </div>
            <div class="form-group">
                <label class="fl">Prayer Category</label>
                <select>
                    <option value="">Select a category...</option>
                    <option>Health &amp; Healing</option>
                    <option>Family &amp; Relationships</option>
                    <option>Work &amp; Finance</option>
                    <option>Salvation for a Loved One</option>
                    <option>Guidance &amp; Direction</option>
                    <option>Grief &amp; Loss</option>
                    <option>Other</option>
                </select>
            </div>
            <div class="form-group">
                <label class="fl">Your Prayer Request *</label>
                <textarea rows="4" placeholder="Share what's on your heart. We believe God hears every prayer..."></textarea>
            </div>
            <hr class="divider" />
            <div class="form-group">
                <label class="fl" style="margin-bottom:10px;">This request is</label>
                <div class="radio-group">
                    <label class="radio-pill"><input type="radio" name="pr-type" value="personal" checked /> Personal</label>
                    <label class="radio-pill"><input type="radio" name="pr-type" value="family" /> For a Family Member</label>
                    <label class="radio-pill"><input type="radio" name="pr-type" value="friend" /> For a Friend</label>
                    <label class="radio-pill"><input type="radio" name="pr-type" value="community" /> For our Community</label>
                </div>
            </div>
            <div class="form-group" style="margin-top:8px;">
                <label class="check-item" style="display:inline-flex; width:auto;">
                    <input type="checkbox" /><span>Keep my request confidential (pastoral team only)</span>
                </label>
            </div>
            <button class="submit-btn"><i class="fa-solid fa-hands-praying"></i> Submit Prayer Request</button>
        </div>
    </div>

    <!-- FORM 4: Membership -->

    <div class="form-card" id="tab-membership">
        <div class="card-header">
            <div class="card-header-icon">
                <i class="fa-solid fa-user-group" style="color:#ffe0e3;"></i>
            </div>
            <div>
                <h3>Membership</h3>
                <p>A public commitment to belong, serve, and grow in The Potter's Church.</p>
            </div>
        </div>

        <div class="card-body">
            <div class="form-row">
                <div class="form-group">
                    <label class="fl">Full Name *</label>
                    <input type="text" placeholder="Your full name" />
                </div>
                <div class="form-group">
                    <label class="fl">Phone Number *</label>
                    <input type="tel" placeholder="+91 00000 00000" />
                </div>
            </div>

           

            <div class="form-row">
                
                <div class="form-group">
                    <label class="fl" style="margin-bottom:10px;">Gender</label>
                    <div class="check-grid-2">
                        <label class="check-item"><input name="gende" value="MALE" type="radio" /><span>Male</span></label>
                        <label class="check-item"><input name="gende" value="FEMALE" type="radio" /><span>Female</span></label>
                        
                    </div>
                </div>
                <div class="form-group">
                    <label class="fl">Date of Birth</label>
                    <input type="date" />
                </div>
            </div>

            <hr class="divider" />
            <div class="form-group">
                <label class="fl"> Address</label>
                
                <textarea placeholder="Your Address"> </textarea>
            </div>

         

            <div class="form-row">
                
                <div class="form-group">
                    <label class="fl" style="margin-bottom:10px;">City</label>
                   
                    <input type="text" placeholder="City" />
                        
                </div>
                <div class="form-group">
                    <label class="fl">State</label>
                    <input type="text" placeholder="State" />
                </div>
            </div>
            <div class="form-row">
                
                <div class="form-group">
                    <label class="fl" style="margin-bottom:10px;">Occupation</label>
                  
                    <input type="text" placeholder="Occupation" />
                       
                </div>
                <div class="form-group">
                    <label class="fl">Email</label>
                    <input type="email" placeholder="Email" />
                </div>
            </div>
            <div class="form-row">
                
                <div class="form-group">
                    <label class="fl" style="margin-bottom:10px;">Marital Status</label>
                    <div class="check-grid-2">
                        <div style="grid-template-columns: 1fr 1fr 1fr !important" class="check-grid-2">
                            <label class="check-item"><input name="maritalstatus" id="married" value="Married" type="radio" /><span>Married</span></label>
                            <label class="check-item"><input name="maritalstatus" value="Unmarried" type="radio" /><span>Unmarried</span></label>
                            <label class="check-item"><input name="maritalstatus" value="Other" type="radio" /><span>Other</span></label>
                        
                        </div>
                        
                    </div>
                </div>
                <div style="display:none" class="form-group marrieddiv">
                    <label class="fl">Anniversary</label>
                    <input type="email" placeholder="Anniversary" />
                </div>
                
            </div>
           
            <div style="display:none" class="form-row marrieddiv">
                
                <div class="form-group">
                    <label class="fl" style="margin-bottom:10px;">Spouse's Name</label>
                  
                    <input type="text" placeholder="Spouse's Name" />
                       
                </div>
                <div class="form-group">
                    <label class="fl">Children</label>
                    <input type="text" placeholder="Children" />
                </div>
            </div>

            <div class="form-row">
                
                <div class="form-group">
                    <label class="fl" style="margin-bottom:10px;">Are you currently a member of another church?</label>
                    <div class="check-grid-2">
                        <div class="check-grid-2">
                            <label class="check-item"><input name="churchmemb" value="yes" type="radio" /><span>Yes</span></label>
                            <label class="check-item"><input name="churchmemb" value="no" type="radio" /><span>No</span></label>
                        </div>
                        
                    </div>
                </div>
                <div style="display:none" class="form-group churchdiv">
                    <label class="fl">Name of church</label>
                    <input type="text" placeholder="Name of church" />
                </div>
            </div>

           

            <div class="form-group">
                <label class="fl">Your Areas Of Interest</label>
                <select>
                    <option value="">Select...</option>
                    <option>Volunteering</option>
                    <option>Bible Studies</option>
                    <option>Children & Youth</option>
                    <option>Worship & Music</option>
                    <option>Tech & Media</option>
                    <option>Outreach</option>
                    
                </select>
            </div>
            <div class="form-group">
                <label class="fl" style="margin-bottom:10px;">Meet Our Pastor</label>
                <div style="grid-template-columns: none !important" class="check-grid-2">
                    <div style="grid-template-columns: none !important" class="check-grid-2">
                        <label class="check-item"><input value="Tuesday" type="checkbox" /><span>Tuesday- 6:00 - 7:00 pm</span></label>
                        <label class="check-item"><input value="Saturday" type="checkbox" /><span>Saturday- 6:00 - 7:30 pm</span></label>
                        <label class="check-item"><input value="Sunday" type="checkbox" /><span>Sunday- 1:00 - 2:00 pm</span></label>
                        
                    </div>
                        
                </div>
            </div>

            
            <button class="submit-btn">
                <i class="fa-solid fa-handshake"></i>
                Apply for Membership
            </button>
        </div>
    </div>

  

    <!-- FORM 3: next steps -->
    <div class="form-card" id="tab-nextsteps">
        <div class="card-header">
            <div class="card-header-icon"><i class="fa-solid fa-people-group" style="color:#ffe0e3;"></i></div>
            <div>
                
                <h3>Next Steps</h3>
                <p>Take the next step in growing closer to Jesus Christ.</p>
            </div>
        </div>
        <div class="card-body">
            <div class="form-row">
                <div class="form-group">
                    <label class="fl">Full Name *</label>
                    <input type="text" placeholder="Your full name" />
                </div>
                <div class="form-group">
                    <label class="fl">Date of Birth</label>
                    <input type="date" />
                </div>
            </div>
            <div class="form-row">
                <div class="form-group">
                    <label class="fl">Phone Number *</label>
                    <input type="tel" placeholder="+91 00000 00000" />
                </div>
                
            </div>
           
            <div class="form-group">
                <label class="fl">How have you experienced God's communication with you</label>
                <textarea rows="3" placeholder="Tell us briefly about your decision to follow Jesus..."></textarea>
            </div>
            <hr class="divider" />
            <div class="form-group">
                <label class="fl" style="margin-bottom:10px;">Decesions</label>
                <div class="check-grid-2">
                    <label class="check-item"><input type="checkbox" /><span>I decided to follow jesus</span></label>
                    <label class="check-item"><input type="checkbox" /><span>I Would like to be Baptised</span></label>
                    <label class="check-item"><input type="checkbox" /><span>I Seek redemption</span></label>
                    <label class="check-item"><input type="checkbox" /><span>I Would like to seek counseling</span></label>
                </div>
            </div>
            <button class="submit-btn"><i class="fa-solid fa-droplet"></i> Register for Next Steps</button>
        </div>
    </div>

  
    

</div>



<!-- ═══════════════ CONNECT SECTION ═══════════════ -->
<section style="margin-bottom:2px;" class="connect-section" id="connect">
