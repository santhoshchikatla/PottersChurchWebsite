                    <div class="social-row">
                        <a href="https://www.instagram.com/potterschurchmedia/#" class="social-badge"><i class="fa-brands fa-instagram"></i> potterschurchmedia</a>
                        <a href="https://www.youtube.com/@@Potterschurchmedia" class="social-badge"><i class="fa-brands fa-youtube"></i> YouTube</a>
                    </div>
                </div>
            </div>

        </div>

        <!-- Location -->
        <div class="row mt-5 fade-up" style="transition-delay:.28s;">
            <div class="col-12">
                <div style="background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.1);border-radius:14px;padding:32px 36px;display:flex;align-items:center;gap:28px;flex-wrap:wrap;">
                    <div style="width:56px;height:56px;background:rgba(167,30,48,.3);border-radius:14px;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                        <i class="fa-solid fa-location-dot" style="font-size:1.6rem;color:#ff9aa4;"></i>
                    </div>
                    <div>
                        <p style="color:rgba(255,255,255,.5);font-size:.75rem;letter-spacing:.12em;text-transform:uppercase;margin:0 0 4px;">Find Us</p>
                        <p style="color:var(--white);font-size:1.05rem;font-weight:600;margin:0;">KPHB 5th Phase, Kukatpally Housing Board Colony, Hyderabad, Telangana 500072</p>
                    </div>
                    <a href="https://maps.app.goo.gl/cKBbq8Tr2CbMQGUc8" target="_blank"
                           style="margin-left:auto;background:var(--white);color:var(--red);font-weight:700;font-size:.85rem;padding:12px 26px;border-radius:8px;text-decoration:none;white-space:nowrap;transition:opacity.2s;"
                           onmouseover="this.style.opacity='.85'" onmouseout="this.style.opacity='1'">
                        Get Directions <i class="fa-solid fa-arrow-up-right-from-square ms-1"></i>
                    </a>
                </div>
            </div>
        </div>

    </div>
</section>



<!-- Toast -->
<div class="toast-wrap" id="toast">
    <div class="toast-box">
        <i class="fa-solid fa-circle-check"></i>
        <div>
            <strong>Welcome Card Submitted!</strong>
            <span>Our team will be in touch soon. God bless you!</span>
        </div>
    </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/js/bootstrap.bundle.min.js"></script>
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script>

    $(document).ready(function()
    {
         $(".marrieddiv").hide();
    });
   
    $("input[name='maritalstatus']").change(function () {
        if ($(this).val() === "Married") {
        $(".marrieddiv").slideDown();
        } else {
        $(".marrieddiv").slideUp();
        }
    });
    $("input[name='churchmemb']").change(function () {
        if ($(this).val() === "yes") {
             $(".churchdiv").slideDown();
        } else {
             $(".churchdiv").slideUp();
        }
    });

    // Scroll animations
    const observer = new IntersectionObserver(entries => {
    entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('visible'); });
    }, { threshold: 0.12 });
    document.querySelectorAll('.fade-up').forEach(el => observer.observe(el));

    // Set today's date
    document.getElementById('fdate').valueAsDate = new Date();

    // Form submit
    document.getElementById('welcomeForm').addEventListener('submit', function(e) {
    e.preventDefault();
    const name = document.getElementById('fname').value.trim();
    if (!name) { document.getElementById('fname').focus(); return; }
    const toast = document.getElementById('toast');
    toast.style.display = 'block';
    setTimeout(() => toast.style.display = 'none', 4500);
    this.reset();
    document.getElementById('fdate').valueAsDate = new Date();
    });

    // Smooth scroll
    document.querySelectorAll('a[href^="#"]').forEach(a => {
    a.addEventListener('click', e => {
    const target = document.querySelector(a.getAttribute('href'));
    if (target) { e.preventDefault(); target.scrollIntoView({ behavior: 'smooth' }); }
    });
    });
</script>

<script>
    document.getElementById('welcome-date').valueAsDate = new Date();
    function showTab(name) {
    document.querySelectorAll('.tab-btn').forEach(function(b){ b.classList.remove('active'); });
    document.querySelectorAll('.form-card').forEach(function(c){ c.classList.remove('active'); });
    var idx = ['welcome','prayer','membership','nextsteps'].indexOf(name);
    document.querySelectorAll('.tab-btn')[idx].classList.add('active');
    document.getElementById('tab-'+name).classList.add('active');
    }
</script>
