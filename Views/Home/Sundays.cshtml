<script>
    function toggleAccordion(btn) {
      const item = btn.closest('.accordion-item');
      const isOpen = item.classList.contains('open');
      document.querySelectorAll('.accordion-item').forEach(i => i.classList.remove('open'));
      if (!isOpen) item.classList.add('open');
    }

    // Scroll-spy: derive sections from the actual subnav links so
    // commented-out sections (#more) never cause index mismatches.
    const subnav = document.querySelector('.subnav');
    const links = Array.from(subnav.querySelectorAll('a'));
    const sections = links.map(link => {
      const id = link.getAttribute('href').replace('#', '');
      return document.getElementById(id); // null if section doesn't exist
    });

    window.addEventListener('scroll', () => {
      let current = 0;
      sections.forEach((s, i) => {
        if (s && window.scrollY >= s.offsetTop - 130) current = i;
      });
      links.forEach((l, i) => l.classList.toggle('active', i === current));
    });
</script>
