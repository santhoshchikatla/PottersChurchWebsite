<script>
    const sermons = [
      {
        img: "https://img.youtube.com/vi/btp-1YIe6JQ/hqdefault.jpg",
        tag: "Sermon 01 · May 2025", title: "Alters Throughout The Scriptures",
        desc: "A journey through Scripture: where worship brought blessing and where it broke — and what it means for us today.",
        meta: [["🕐 42 min"], ["📖 Genesis 12 · Romans 12"]],
        notesTag: "Sermon Notes · May 2025",
        notes: ["Altars represent points of surrender and encounter with God","From Abraham to Elijah — every altar was a turning point","What altars in your own life need to be rebuilt?","Key verse: Romans 12:1 — offer yourself as a living sacrifice"],
        thumbLabel: "Sermon 01 · Video"
      },
      {
        img: "https://img.youtube.com/vi/GI64CPsn2V4/hqdefault.jpg",
        tag: "Sermon 02 · Apr 2025", title: "Teach Us To Pray",
        desc: "The Prayer of Jesus (John 17) — when Jesus lifted up his eyes to heaven and spoke directly to the Father.",
        meta: [["🕐 38 min"], ["📖 John 17 · Matthew 6"]],
        notesTag: "Sermon Notes · Apr 2025",
        notes: ["Prayer is not a ritual — it is relationship with the Father","Jesus modeled surrender: 'not my will but yours'","The Lord's Prayer is a blueprint, not a script","Key verse: John 17:1 — 'Father, the hour has come'"],
        thumbLabel: "Sermon 02 · Video"
      },
      {
        img: "https://img.youtube.com/vi/GI64CPsn2V4/hqdefault.jpg",
        tag: "Sermon 03 · Mar 2025", title: "The Upsidedown Kingdom",
        desc: "Two ways, two trees, two voices, two foundations — every verse invites us to choose what kind of disciples we will be.",
        meta: [["🕐 45 min"], ["📖 Matthew 5 · Luke 6"]],
        notesTag: "Sermon Notes · Mar 2025",
        notes: ["The Kingdom of God flips every worldly value upside down","Blessed are the poor in spirit — strength is found in humility","Two foundations: one built on sand, one on rock","Key verse: Matthew 5:3 — 'Blessed are the poor in spirit'"],
        thumbLabel: "Sermon 03 · Video"
      }
    ];

    function selectSermon(idx) {
      const s = sermons[idx];
      document.getElementById('mainImg').src = s.img;
      document.getElementById('videoTag').textContent = s.tag;
      document.getElementById('videoTitle').textContent = s.title;
      document.getElementById('videoDesc').textContent = s.desc;
      document.getElementById('videoMeta').innerHTML = s.meta.map(m => `<span>${m}</span>`).join('');
      // document.getElementById('videoThumbLabel').textContent = s.thumbLabel;
      document.getElementById('notesTag').textContent = s.notesTag;
      document.getElementById('notesTitle').textContent = s.title;
      document.getElementById('notesList').innerHTML = s.notes.map(n => `<li>${n}</li>`).join('');
      document.querySelectorAll('.s-card').forEach((c, i) => c.classList.toggle('active', i === idx));
      document.getElementById('mainCards').scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }
</script>
    
